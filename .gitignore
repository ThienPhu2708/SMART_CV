# --- Môi trường ảo (Virtual Environment) ---
# Tuyệt đối không đẩy thư mục này lên GitHub vì nó rất nặng và chứa các đường dẫn cục bộ
venv/
env/

# --- Python cache ---
# Các tệp tạm phát sinh khi chạy code Python
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Thư mục Models ---
# Chặn các file trọng số nặng nhưng vẫn giữ thư mục
Models/*.pth
Models/*.h5
Models/*.model

# --- Thư mục Data ---
# Chặn dữ liệu đã xử lý nhưng giữ lại file .gitkeep để hiện thư mục trên GitHub
Data/Processed/*
!Data/Processed/.gitkeep

# --- IDE và Hệ thống ---
.vscode/
.idea/

# --- Tệp rác của hệ thống ---
.DS_Store
Thumbs.db